<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.chatdesktop.controller.ChatController">

    <!-- ========================= -->
    <!-- TOPO -->
    <!-- ========================= -->

    <top>

        <HBox
                spacing="15"
                alignment="CENTER_LEFT">

            <padding>
                <Insets
                        top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <!-- Título e modelo -->

            <VBox
                    spacing="5"
                    HBox.hgrow="ALWAYS">

                <Label
                        text="Chat com IA"
                        styleClass="titulo"/>

                <Label
                        text="Groq • openai/gpt-oss-20b"
                        styleClass="modelo"/>

            </VBox>


            <!-- Nova conversa -->

            <Button
                    text="Nova conversa"
                    onAction="#novaConversa"
                    styleClass="botao-nova-conversa"/>

        </HBox>

    </top>


    <!-- ========================= -->
    <!-- CENTRO -->
    <!-- ========================= -->

    <center>

        <VBox spacing="10">

            <padding>
                <Insets
                        top="0"
                        right="15"
                        bottom="0"
                        left="15"/>
            </padding>

            <TextArea
                    fx:id="areaChat"
                    editable="false"
                    wrapText="true"
                    promptText="A conversa aparecerá aqui..."
                    VBox.vgrow="ALWAYS"/>

        </VBox>

    </center>


    <!-- ========================= -->
    <!-- PARTE INFERIOR -->
    <!-- ========================= -->

    <bottom>

        <VBox spacing="8">

            <padding>
                <Insets
                        top="15"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>


            <!-- Campo + Enviar -->

            <HBox spacing="10">

                <TextField
                        fx:id="campoMensagem"
                        promptText="Digite sua mensagem..."
                        HBox.hgrow="ALWAYS"
                        onAction="#enviarMensagem"/>

                <Button
                        fx:id="botaoEnviar"
                        text="Enviar"
                        prefWidth="100"
                        onAction="#enviarMensagem"/>

            </HBox>


            <!-- Copiar resposta -->

            <HBox
                    spacing="10"
                    alignment="CENTER_RIGHT">

                <Button
                        fx:id="botaoCopiar"
                        text="Copiar resposta"
                        disable="true"
                        onAction="#copiarResposta"
                        styleClass="botao-copiar"/>

            </HBox>

        </VBox>

    </bottom>

</BorderPane>